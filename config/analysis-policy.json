{
  "schema_version": "gss-analysis-policy/v3",
  "thresholds": {
    "previous_window": {
      "candidate_points": 1.0,
      "action_points": 2.0
    },
    "prior_year": {
      "candidate_points": 2.0,
      "action_points": 5.0
    }
  },
  "confidence": {
    "high_minimum_responses": 100,
    "developing_minimum_responses": 50,
    "low_minimum_responses": 1,
    "developing_requires_threshold_and_corroboration": true,
    "low_eligible_for_top_findings": false,
    "not_scored_eligible_for_top_findings": false
  },
  "rolling_windows": {
    "weeks": 13,
    "adjacent_overlap_weeks": 12
  },
  "guest_feedback": {
    "minimum_unique_responses_per_theme": 2,
    "theme_categories_are_non_exclusive": true
  },
  "population_export": {
    "required_before_inference_or_modeling": true,
    "source_sha256_definition": "sha256_canonical_json_omitting_source_sha256",
    "reporting_week": {
      "start_day": "Monday",
      "end_day": "Sunday",
      "date_basis": "local_visit_date"
    },
    "required_fields": [
      "response_id",
      "restaurant_id",
      "visit_date",
      "overall",
      "service",
      "culinary",
      "value",
      "pace",
      "recommend",
      "first_visit",
      "questionnaire_version",
      "conditional_eligibility"
    ],
    "optional_fields": [
      "manager_visit"
    ],
    "reconciliation": {
      "count_delta_maximum_rate": 0.01,
      "count_delta_minimum_absolute": 1,
      "score_delta_maximum_percentage_points": 0.10,
      "response_ids_must_be_unique": true,
      "core_rating_completeness_minimum_rate": 0.99,
      "visit_date_completeness_minimum_rate": 1.0,
      "restaurant_completeness_minimum_rate": 1.0,
      "failure_status": "DataBlocked"
    }
  },
  "inference": {
    "primary_outcome": {
      "field": "overall",
      "event_values": [1, 2, 3],
      "label": "low_overall"
    },
    "secondary_outcome": {
      "field": "recommend",
      "event_minimum": 0,
      "event_maximum": 6,
      "label": "recommend_detractor"
    },
    "comparison": {
      "current_window_weeks": 13,
      "previous_window_weeks": 13,
      "windows_overlap": false,
      "interval_method": "newcombe_independent_score",
      "multiple_testing_method": "benjamini_hochberg",
      "false_discovery_rate": 0.10,
      "minimum_responses_per_window": 100,
      "minimum_practical_difference_percentage_points": 2.0,
      "confidence_level": 0.95
    },
    "descriptive_only": [
      "adjacent_rolling_windows",
      "sorensen_benchmark",
      "all_franchisees_benchmark"
    ]
  },
  "driver_model": {
    "mode": "shadow",
    "runtime": {
      "python": "3.12",
      "network_allowed_during_run": false,
      "dependencies": [
        "numpy",
        "scipy",
        "scikit-learn"
      ],
      "dependencies_must_be_hash_locked": true
    },
    "algorithm": "l2_logistic_regression",
    "primary_outcome": "low_overall",
    "secondary_outcome": "recommend_detractor",
    "predictors": [
      "service_one_point_worsening",
      "culinary_one_point_worsening",
      "value_one_point_worsening",
      "pace_one_point_worsening"
    ],
    "controls": [
      "restaurant",
      "first_visit",
      "questionnaire_version",
      "time"
    ],
    "excluded_inputs": [
      "guest_name",
      "contact_information",
      "free_text",
      "recommend_as_predictor",
      "individual_predictions"
    ],
    "manager_visit_sensitivity_only": true,
    "regularization_c_grid": [0.03, 0.1, 0.3, 1.0, 3.0],
    "validation": {
      "expanding_validation_block_weeks": 4,
      "minimum_training_weeks_before_fold": 8,
      "holdout_weeks": 8,
      "selection_metric": "brier_score",
      "bootstrap_repetitions": 1000,
      "bootstrap_unit": "week",
      "random_seed": 20260723,
      "all_folds_must_converge": true,
      "final_model_must_converge": true,
      "all_bootstrap_repetitions_required": true
    },
    "shadow_minimums": {
      "usable_responses": 500,
      "primary_events": 100,
      "weeks": 26,
      "distinct_weekly_cycles": 8,
      "cycle_evidence": "verified_append_only_aggregate_ledger"
    },
    "store_specific_minimums": {
      "usable_responses_per_store": 500,
      "primary_events_per_store": 100
    },
    "promotion": {
      "explicit_approval_required": true,
      "minimum_weeks": 52,
      "minimum_responses": 1000,
      "minimum_primary_events": 200,
      "minimum_validation_folds": 3,
      "minimum_brier_improvement_rate": 0.05,
      "minimum_auc": 0.70,
      "calibration_model_must_converge": true,
      "calibration_slope_minimum": 0.75,
      "calibration_slope_maximum": 1.25,
      "calibration_intercept_absolute_maximum": 0.10,
      "top_factor_sign_stability_minimum_rate": 0.80
    },
    "outputs": [
      "model_summary.json",
      "model_estimates.csv",
      "model_diagnostics.json",
      "input_manifest.json",
      "model_card.md"
    ],
    "row_level_persistence_allowed": false,
    "email_attachment_allowed_in_shadow": false,
    "blocks_workbook_or_backup_or_package": false
  },
  "forecasting": {
    "status": "Deferred",
    "minimum_contiguous_population_weeks": 52,
    "minimum_weeks_for_annual_seasonality": 104
  },
  "review_controls": {
    "human_review_required": true,
    "automatic_sending_enabled": false,
    "causation_claimed": false,
    "statistical_significance_claimed": false
  }
}
