{
  "schema_version": "gss-analysis-policy/v4",
  "thresholds": {
    "previous_window": {
      "candidate_points": 1.0,
      "action_points": 2.0
    },
    "prior_year": {
      "candidate_points": 2.0,
      "action_points": 5.0
    }
  },
  "confidence": {
    "semantic_label": "ResponseVolumeTier",
    "high_minimum_responses": 100,
    "developing_minimum_responses": 50,
    "low_minimum_responses": 1,
    "developing_requires_threshold_and_corroboration": true,
    "low_eligible_for_top_findings": false,
    "not_scored_eligible_for_top_findings": false
  },
  "rolling_windows": {
    "weeks": 13,
    "adjacent_overlap_weeks": 12
  },
  "guest_feedback": {
    "minimum_unique_responses_per_theme": 2,
    "theme_categories_are_non_exclusive": true,
    "scope_label": "Among guests who provided comments"
  },
  "source_design": {
    "population_scores_source": "rolling_aggregate_workbook",
    "population_scope_label": "Population aggregate - all submitted surveys",
    "population_raw_rows_available": false,
    "row_level_scores_source": "surveys_with_comments_only",
    "raw_row_scope": "comment_bearing_surveys_only",
    "commenter_scope_label": "Among guests who provided comments",
    "non_comment_row_level_scores_available": false,
    "commenter_rows_population_representative": false,
    "population_driver_modeling_supported": false,
    "population_driver_modeling_status": "PopulationRawDataUnavailable",
    "population_driver_modeling_reason_code": "non_comment_survey_rows_not_provided"
  },
  "commenter_lens": {
    "enabled": true,
    "scope_label": "Among guests who provided comments",
    "reporting_window_weeks": 13,
    "material_gap_percentage_points": 2.0,
    "maximum_reconstructed_event_count_error": 0.01,
    "metrics": [
      {
        "id": "low_overall",
        "response_field": "overall",
        "population_metric": "Overall Dissat (Lower Is Better)",
        "event_minimum": 1,
        "event_maximum": 3
      },
      {
        "id": "low_service",
        "response_field": "service",
        "population_metric": "Service Dissat (Lower Is Better)",
        "event_minimum": 1,
        "event_maximum": 3
      },
      {
        "id": "low_culinary",
        "response_field": "culinary",
        "population_metric": "Culinary Dissat (Lower Is Better)",
        "event_minimum": 1,
        "event_maximum": 3
      },
      {
        "id": "low_value",
        "response_field": "value",
        "population_metric": "Value Dissat (Lower Is Better)",
        "event_minimum": 1,
        "event_maximum": 3
      },
      {
        "id": "low_pace",
        "response_field": "paceofmeal",
        "population_metric": "Pace Of Meal Dissat (Lower Is Better)",
        "event_minimum": 1,
        "event_maximum": 3
      },
      {
        "id": "recommend_detractor",
        "response_field": "recommend",
        "population_metric": null,
        "event_minimum": 0,
        "event_maximum": 6
      }
    ],
    "status_values": [
      "Ready",
      "InsufficientData",
      "DataQualityReview"
    ],
    "population_prevalence_claim_allowed": false,
    "statistical_significance_claim_allowed": false,
    "causation_claim_allowed": false,
    "individual_prediction_allowed": false,
    "row_level_persistence_allowed": false,
    "email_attachment_allowed": false,
    "outputs": [
      "commenter_lens.json",
      "commenter_lens.csv"
    ]
  },
  "modeling": {
    "status": "PopulationRawDataUnavailable",
    "reason_code": "non_comment_survey_rows_not_provided",
    "reason": "Raw row scores are structurally available only for surveys with comments, so population driver modeling is unsupported.",
    "nonblocking": true,
    "blocks_workbook_or_backup_or_package": false,
    "row_level_persistence_allowed": false,
    "email_attachment_allowed": false
  },
  "forecasting": {
    "status": "Deferred",
    "source": "aggregate_population_history_only",
    "minimum_contiguous_population_weeks": 52,
    "minimum_weeks_for_annual_seasonality": 104,
    "population_forecast_published": false
  },
  "review_controls": {
    "human_review_required": true,
    "automatic_sending_enabled": false,
    "causation_claimed": false,
    "statistical_significance_claimed": false,
    "population_prevalence_claimed_from_commenter_rows": false
  }
}
